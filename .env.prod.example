# Variáveis da stack de PRODUÇÃO (docker-compose.prod.yml).
#
# No Portainer: Stacks > Add stack > Repository > "Environment variables" > "Load variables from .env file" (ou cole
# linha a linha). NÃO commite o arquivo preenchido: ele tem segredos. O .gitignore já ignora ".env*".
#
# Gerar segredos:  openssl rand -hex 32   (JWT_API_SECRET, API_TOKEN_SALT)
#                  openssl rand -hex 24   (POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD)
# Use HEXADECIMAL nas senhas do banco e do MinIO: entram em URLs, e caracteres especiais as quebrariam.
# Os valores abaixo marcados com <...> são OBRIGATÓRIOS: sem eles o deploy falha com uma mensagem indicando qual falta.

# ---------------------------------------------------------------------------
# Endereço público (obrigatório)
# ---------------------------------------------------------------------------
# Origem pública, em https e SEM barra final. Dela derivam PUBLIC_URL, CORS, STORAGE_PUBLIC_URL (/storage),
# MTLOGIN_REDIRECT_URI (/auth/callback) e NEXT_PUBLIC_APP_URL. Mudar o domínio exige reconstruir a imagem do web.
APP_URL=https://<convenios.exemplo.gov.br>

# ---------------------------------------------------------------------------
# Rede
# ---------------------------------------------------------------------------
# Rede externa do proxy do servidor (precisa existir: docker network create proxy).
PROXY_NETWORK=proxy
# Porta no LOOPBACK do host para o proxy do servidor, caso ele não use a rede Docker (nunca fica exposta à internet).
HAPROXY_PORT=8090
# Sub-rede FIXA da rede interna; é também o TRUSTED_PROXIES da API (IP real do cliente no rate limit).
# Só mude se der "Pool overlaps" (faixa já usada por outra rede do Docker).
APP_SUBNET=10.231.0.0/24

# ---------------------------------------------------------------------------
# Segredos (obrigatórios)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=<openssl rand -hex 24>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
JWT_API_SECRET=<openssl rand -hex 32>
API_TOKEN_SALT=<openssl rand -hex 32>

# ---------------------------------------------------------------------------
# Login — MT Login (Keycloak) PRODUÇÃO (obrigatório)
# ---------------------------------------------------------------------------
# Cadastre no client do Keycloak: URL de retorno <APP_URL>/auth/callback e de pós-logout <APP_URL>/auth/sign-in.
# Os endereços de produção são solicitados à SEPLAG (governancadigital@seplag.mt.gov.br); os de homologação ficam
# em .env.example (hml.login.mt.gov.br) e NÃO devem ser usados aqui.
MTLOGIN_AUTHORIZATION_URI=<https://.../protocol/openid-connect/auth>
MTLOGIN_TOKEN_URI=<https://.../protocol/openid-connect/token>
MTLOGIN_END_SESSION_URI=<https://.../protocol/openid-connect/logout>
MTLOGIN_CLIENT_ID=<client-id>
# Só para client confidencial; client público (PKCE) deixa em branco.
MTLOGIN_CLIENT_SECRET=
# Validação dos tokens pela API.
JWKS_URI=<https://.../protocol/openid-connect/certs>
OIDC_ISSUER=<https://.../realms/...>
OIDC_CPF_CLAIM=preferred_username
# CPFs (separados por vírgula) que viram Super Admin a cada deploy. Sem isso ninguém tem permissões no primeiro acesso.
SEED_SUPER_ADMIN_CPF=<000.000.000-00>

# ---------------------------------------------------------------------------
# E-mail (obrigatório: sem SMTP nenhum aviso sai)
# ---------------------------------------------------------------------------
SMTP_HOST=<smtp.gmail.com>
SMTP_PORT=587
SMTP_USER=<usuario>
SMTP_PASSWORD=<senha-de-app>
SMTP_FROM=<no-reply@exemplo.gov.br>

# ---------------------------------------------------------------------------
# Opcionais (os valores abaixo são os padrões)
# ---------------------------------------------------------------------------
# POSTGRES_USER=convenios
# POSTGRES_DB=convenios
# MINIO_ROOT_USER=convenios-minio
# MINIO_BUCKET=documentos
# LOG_LEVEL=info
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_GLOBAL_PER_MINUTE=600

# Backup do PostgreSQL: hora (UTC; 6 = 02h em Cuiabá), retenção em dias e um backup logo ao subir a stack.
# BACKUP_HOUR_UTC=6
# BACKUP_RETENTION_DAYS=14
# BACKUP_ON_START=false

# Limpeza diária. CLEANUP_DRAFT_DAYS > 0 apaga rascunhos de projeto sem alteração há mais de N dias (0 = nunca).
# CLEANUP_DAYS=7
# CLEANUP_DRAFT_DAYS=0

# Limites de memória por serviço.
# API_MEM_LIMIT=512m
# WEB_MEM_LIMIT=768m
# DB_MEM_LIMIT=1g
# MINIO_MEM_LIMIT=1g
# GOTENBERG_MEM_LIMIT=2g
# CLAMAV_MEM_LIMIT=3g

# Imagens de terceiros (para fixar versão ou usar um espelho).
# GOTENBERG_IMAGE=gotenberg/gotenberg:8
# CLAMAV_IMAGE=clamav/clamav:1.4
# MINIO_IMAGE=chainguard/minio@sha256:d88920d6a50bd0b088223b688be3b76c63e6205dbe494437f67ba1240ea12880
# MINIO_MC_IMAGE=chainguard/minio-client@sha256:72f9978d415ea8294d78051fb3aee2fd258d449237633f77f100b5367bb5225d
